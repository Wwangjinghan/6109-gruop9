PORT=3001

# Chain
CHAIN=sepolia
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Relayer agent (signs UserOperations as the 'agent' role on IntentAccount)
RELAYER_PRIVATE_KEY=0x...

# The user's deployed IntentAccount address
ACCOUNT_ADDRESS=0x...

# DEX router (Uniswap v2 compatible) — used for SWAP intent encoding
SWAP_ROUTER_ADDRESS=0x...

# ERC-4337 EntryPoint — defaults to canonical v0.7 if unset
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Batcher tuning
BATCH_SIZE=10
BATCH_WINDOW_MS=5000

# Parallel submission limit (Semaphore — increase for multi-account setups)
MAX_CONCURRENT=3

LOG_LEVEL=info

# ─── ZK Stack L2 override (uncomment for ./run_demo.sh --zk) ─────────────────
# CHAIN=zksync
# RPC_URL=http://127.0.0.1:3050
# ENTRY_POINT_ADDRESS=<address from contracts/script/.env.zk>

# ─── Agent Simulator (src/simulator/agent_simulator.ts) ───────────────────────

# Required
SIMULATOR_AGENT_PRIVATE_KEY=0x...          # key that signs DCA intents as the 'agent' role
SIMULATOR_RELAYER_URL=http://localhost:3001
SIMULATOR_USER_ID=agent-sim-user-1
SIMULATOR_TOKEN_IN=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48   # USDC on mainnet
SIMULATOR_TOKEN_OUT=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2  # WETH on mainnet
SIMULATOR_AMOUNT_PER_INTERVAL=1000000   # 1 USDC (6 decimals)
SIMULATOR_INTERVAL_SECONDS=86400        # daily
SIMULATOR_TOTAL_INTERVALS=7             # one week of daily buys

# Condition — fires a DCA intent when ETH drops below $2 000
SIMULATOR_CONDITION_TYPE=BELOW          # BELOW | ABOVE | PERCENT_DROP | PERCENT_RISE
SIMULATOR_THRESHOLD_USD=2000            # used by BELOW and ABOVE
SIMULATOR_PERCENT=5                     # used by PERCENT_DROP and PERCENT_RISE

# Price feed
SIMULATOR_PRICE_FEED=coingecko          # coingecko | mock
SIMULATOR_COINGECKO_API_KEY=            # optional CoinGecko Pro key
SIMULATOR_ASSET=ethereum                # CoinGecko asset ID

# Timing
SIMULATOR_POLL_INTERVAL_MS=60000        # check price every 60 s
SIMULATOR_COOLDOWN_MS=3600000           # minimum 1 h between triggers

# Mock feed (only used when SIMULATOR_PRICE_FEED=mock)
SIMULATOR_MOCK_INITIAL_PRICE=2500       # starting price in USD
SIMULATOR_MOCK_DRIFT_PERCENT=-1         # price drops 1% per tick
